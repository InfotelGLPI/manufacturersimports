{% if no_results %}
    <div class="alert alert-info text-center">
        <strong>{{ __('No device finded', 'manufacturersimports') }}</strong>
    </div>
{% else %}

    {% set pager_params = {
        'href':  target ~ '?' ~ parameters,
        'start': start,
        'count': numrows,
        'limit': list_limit
    } %}

    {{ include('components/pager.html.twig', pager_params) }}

    <form method="post" name="massiveaction_form" id="massiveaction_form"
          action="{{ plugin_webdir }}/front/massiveaction.php">

        {{ include('components/datatable.html.twig', {
            'columns':            columns,
            'formatters':         formatters,
            'entries':            entries,
            'total_number':       total_number,
            'filtered_number':    filtered_number,
            'showmassiveactions': false,
            'nofilter':           true,
            'nosort':             true,
            'is_tab':             false
        }) }}

        <div class="mt-2 ms-2">
            {{ __('Total number of devices to import %s', 'manufacturersimports')|format(total_devices) }}
        </div>

        {% if canedit %}
            {% if list_limit < max_input_vars %}
                <div class="d-flex flex-wrap align-items-center gap-2 mt-2 ms-2">
                    <i class="ti ti-corner-left-up"></i>
                    <button type="button" class="btn btn-sm btn-ghost-secondary"
                            data-manufacturersimports-check="1">{{ __('Check all') }}</button>
                    <span>/</span>
                    <button type="button" class="btn btn-sm btn-ghost-secondary"
                            data-manufacturersimports-check="0">{{ __('Uncheck all') }}</button>

                    {# front/massiveaction.php reads "action"; "id" only flags a non-empty list #}
                    <select class="form-select w-auto" name="action" required
                            aria-label="{{ __('Actions') }}">
                        <option value="" selected>{{ empty_value }}</option>
                        {% if can_import %}
                            <option value="import">{{ __('Import') }}</option>
                        {% endif %}
                        <option value="reinit_once">{{ __('Reset the import', 'manufacturersimports') }}</option>
                    </select>
                    <input type="hidden" name="id" value="{{ comp_id }}">
                    <input type="hidden" name="itemtype" value="{{ itemtype }}">
                    <input type="hidden" name="start" value="{{ start }}">
                    <input type="hidden" name="manufacturers_id" value="{{ manufacturers_id }}">
                    <input type="hidden" name="imported" value="{{ imported }}">
                    <button type="submit" name="massiveaction" class="btn btn-primary">
                        {{ _x('button', 'Post') }}
                    </button>
                </div>
                <script type="module" src="{{ plugin_webdir }}/scripts/pre-import.js"></script>
            {% else %}
                <div class="alert alert-warning">
                    {{ __('Selection too large, massive action disabled.') }}
                </div>
            {% endif %}
        {% endif %}

    </form>

    {{ include('components/pager.html.twig', pager_params) }}

{% endif %}
